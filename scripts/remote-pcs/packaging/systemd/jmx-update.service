[Unit]
Description=Update JMX remote and setup packages
Documentation=https://github.com/yetanothernaveed/JMX-Exam-Suite
After=network-online.target
Wants=network-online.target
# Never update or re-provision while an exam session is active.
ConditionPathExists=!/run/jmx/sessions/current_session.txt
ConditionPathExists=!/etc/jmx/jmx-setup-hold

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
Environment=NEEDRESTART_SUSPEND=1
ExecStart=/bin/bash -c 'apt-get update -qq && apt-get install -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold --only-upgrade jmxremote jmxsetup'
ExecStartPost=-/bin/systemctl start jmx-provision.service
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
