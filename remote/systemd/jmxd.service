[Unit]
Description=jmx privileged command daemon
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/jmxd
Restart=on-failure
RestartSec=1

# systemd creates /run/jmx (mode 0750, owned by root:jmx) right before
# starting the service and removes it on stop; jmxd then creates its
# socket file inside that directory. This is what makes the daemon
# "keep listening in the background" across logins/reboots.
RuntimeDirectory=jmx
RuntimeDirectoryMode=0750

# The daemon needs elevated privilege per the current design. If you
# later find a specific Linux capability covers everything jmxd needs
# (e.g. CAP_NET_ADMIN, CAP_DAC_OVERRIDE), switch to a dedicated
# unprivileged service account plus AmbientCapabilities= instead of
# full root -- smaller blast radius if a future command has a bug.
User=root
Group=jmx

# Baseline hardening; tighten further as real commands are added
# (e.g. add SystemCallFilter=, restrict ReadWritePaths= to exactly
# what jmxd touches).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
