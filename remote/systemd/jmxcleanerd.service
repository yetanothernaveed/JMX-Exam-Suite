[Unit]
Description=Archive expired exam files and reset the kiosk at slot boundaries
After=local-fs.target systemd-logind.service
ConditionPathExists=/home/examkiosk/exam_workspace

[Service]
LogsDirectory=jmxcleanerd
StateDirectory=jmxcleanerd
StateDirectoryMode=0700

Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/local/bin/jmxcleanerd --slot-reset
